# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string — signs the donor login cookie
SESSION_SECRET=

# Razorpay (Test mode) → Account & Settings → API Keys / Webhooks   (needed from Step 4)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API → WhatsApp → API Setup   (needed from Step 8)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Public URL of the deployed site (used in WhatsApp links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
